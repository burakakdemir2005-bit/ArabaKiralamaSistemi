@using Microsoft.AspNetCore.Identity
@model IEnumerable<ArabaKiralamaSistemi.Models.Car>

@{
    ViewData["Title"] = "Araç Filosu";
}

<div class="container" style="margin-top: 50px; margin-bottom: 50px;">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-bold text-white">Araç Filosu</h1>
            <p class="text-muted">Size en uygun aracı seçin ve yola çıkın.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-lg px-4 rounded-pill shadow">
                + Yeni Araç Ekle
        </a>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0" style="border-radius: 20px; overflow: hidden; background-color: #232334;">

                    <div style="height: 250px; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">
                        <img src="@item.ImageUrl" alt="@item.Brand" style="width: 100%; height: 100%; object-fit: contain; padding: 10px;">

                        <span class="position-absolute top-0 end-0 bg-primary text-white px-3 py-2 fw-bold" style="border-bottom-left-radius: 20px; font-size: 1.1rem;">
                            @item.DailyPrice ₺ <small style="font-size:0.7rem;">/Gün</small>
                        </span>
                    </div>

                    <div class="card-body text-white p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title fw-bold fs-4 mb-0">@item.Brand @item.Model</h5>
                            <span class="badge bg-secondary">@item.Year</span>
                        </div>

                        <p class="text-muted small mb-3">Plaka: @item.Plate</p>

                        <div class="mb-4">
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">
                                    ● Kiralamaya Uygun
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill">
                                    ● Şu an Kirada
                                </span>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-light rounded-pill py-2">Detayları İncele</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-dark w-100 rounded-pill py-2" style="border: 1px solid #444;">Düzenle</a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger w-100 rounded-pill py-2">Sil</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>