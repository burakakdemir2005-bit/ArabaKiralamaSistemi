@using Microsoft.AspNetCore.Identity
@using ArabaKiralamaSistemi.Areas.Identity.Data

@inject SignInManager<ArabaKiralamaSistemiUser> SignInManager
@inject UserManager<ArabaKiralamaSistemiUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a id="manage" class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index" title="Profilim">
                Merhaba, @UserManager.GetUserName(User)!
            </a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-danger border-0" style="text-decoration: none;">Çıkış Yap</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" id="register" asp-area="Identity" asp-page="/Account/Register">Kayıt Ol</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary ms-2" id="login" asp-area="Identity" asp-page="/Account/Login" style="border-radius: 20px; padding: 5px 20px;">Giriş Yap</a>
        </li>
    }
</ul>